# Auto detect text files and perform LF normalization
* text=auto

# android/ artık depoda ve Gradle sarmalayıcısı satır sonuna duyarlı: gradlew bir
# sh betiği, CRLF ile checkout edilirse Linux'ta "bad interpreter" verir; .bat ise
# cmd.exe için CRLF olmalı. "text=auto" bunu platforma göre tahmin ediyordu —
# burada tahmine bırakılmıyor.
android/gradlew      text eol=lf
android/gradlew.bat  text eol=crlf

# Sarmalayıcı jar'ı ikili; normalizasyon bozar.
*.jar binary

# Bu ikisini "cap sync" her koşuda LF ile yeniden yazıyor. Windows'ta checkout
# CRLF verseydi, senkronizasyondan sonra içerik aynı olduğu hâlde git bunları
# değişmiş gösterirdi — "cap sync android/ altında hiçbir şey değiştirmez"
# kuralını yalnız Linux'ta doğru kılardı.
android/capacitor.settings.gradle   text eol=lf
android/app/capacitor.build.gradle  text eol=lf
