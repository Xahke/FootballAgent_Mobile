node_modules/
www/

# android/ artık depoda. Eskiden ignore ediliyordu ve CI her koşuda "cap add
# android" ile şablondan yeniden üretiyordu; bu, debug APK için çalışıyordu ama
# native tarafa yazılan hiçbir şeyin yaşamasına izin vermiyordu — imza
# yapılandırması, versionCode, manifest meta-data'sı, ikonlar, ProGuard kuralları
# bir sonraki derlemede sessizce siliniyordu. Capacitor'ın kendi belgesi de
# native klasörü kaynak artefaktı sayıyor. Artık akış "cap add" değil "cap sync".
#
# Neyin girip neyin girmediği android/.gitignore'da: derleme çıktıları
# (.gradle/, build/, *.apk, *.aab), local.properties ve cap sync'in her koşuda
# yeniden ürettiği dosyalar (assets/public, capacitor.config.json,
# capacitor.plugins.json, res/xml/config.xml, capacitor-cordova-android-plugins)
# dışarıda kalır.

# package-lock.json artık depoda. CI "npm install" ile her koşuda farklı yama
# sürümleri çekebiliyordu; mağazaya çıkan bir uygulamada derlemenin tekrar
# üretilebilir olması gerekiyor. CI "npm ci" kullanıyor ve kilit dosyasını
# kaynak kabul ediyor.

# Natural Earth kaynağının yerel kopyası. Üretilen js/worldgeo.js depoda
# durduğu için oyunun buna ihtiyacı yok; yalnız yeniden üretirken indirilir.
tools/.geocache/

# --- public repo: bunlar asla commit'lenmemeli ---
# Android imza anahtarı ve parolaları. Sızarsa uygulamanın sahte sürümü imzalanabilir.
*.jks
*.keystore
key.properties
keystore.properties
local.properties

# Reklam / analitik yapılandırmaları (AdMob, Firebase) — uygulama kimliği içerir
google-services.json
GoogleService-Info.plist

# Ortam değişkenleri
.env
.env.*

# IDE kullanıcı dosyaları. Capacitor şablonunun android/.gitignore'ı yalnız
# seçili birkaçını (workspace.xml, gradle.xml, modules.xml…) sayıyor; Android
# Studio projeyi ilk açtığında misc.xml, compiler.xml, runConfigurations.xml ve
# birkaç dosya daha bırakıyor ve bunlar açıkta kalıyordu. Hiçbiri projenin
# tanımı değil — makinenin ve kullanıcının tercihleri. Kural burada, kökte,
# çünkü hem ./.idea hem android/.idea aynı sebeple dışarıda kalmalı.
.idea/
